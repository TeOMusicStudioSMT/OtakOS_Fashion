# ── Zależności i wyniki budowania ────────────────────────────────────────────
node_modules/
dist/
*.log

# ── Sekrety ──────────────────────────────────────────────────────────────────
# ⚠️ NIGDY nie commitujemy kluczy. Chmura jest tu i tak wyłączona domyślnie,
# ale plik .env potrafi przyjechać z cudzego szablonu.
.env
.env.*
!.env.example

# ── Materiał generowany ──────────────────────────────────────────────────────
# `public/kadry/` to KOPIA obrazów z `katalog/`, robiona przez
# scripts/zwiaz-obrazy.mjs. Trzymanie dwóch kopii w repozytorium to 23 MB
# duplikatu i dwa źródła prawdy o tym, która wersja jest aktualna.
public/kadry/

# Kreacje wykute przez Jajo — wynik pracy, nie kod. Rosną z każdym kuciem.
OtakOs_Fashion/kreacje.json

# ── Pliki tymczasowe ─────────────────────────────────────────────────────────
*.tmp
*.tmp.json
.DS_Store

# ── Dane instancji — wynik pracy, nie kod ───────────────────────────
# Marki, wgrane logo, narysowane kreacje i ofirmowane pliki należą do TEJ
# Katedry. W repozytorium byłyby cudzym portfolio i rosnącą górą PNG.
OtakOs_Fashion/marki.json
OtakOs_Fashion/wizualizacje.json
OtakOs_Fashion/obroty.json
OtakOs_Fashion/logo/
public/ofirmowane/
